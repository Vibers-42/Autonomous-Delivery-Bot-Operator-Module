# ─────────────────────────────────────────────────────────────────────────────
# NAVIX AI AMR BACKEND & COMPUTER VISION PIPELINE CONFIGURATION
# ─────────────────────────────────────────────────────────────────────────────

# Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=True

# ESP32 Robot Hardware Connection
ESP32_IP=192.168.4.1
ESP32_HEALTH_CHECK_INTERVAL_SEC=5

# Computer Vision & Machine Learning Pipeline
VISION_ENABLED=True
VISION_AUTO_MODE=True
YOLO_MODEL_PATH=yolov8n.pt
MIDAS_MODEL_NAME=MiDaS_small
CONFIDENCE_THRESHOLD=0.45
STOP_DISTANCE_M=0.8
SLOW_DISTANCE_M=1.5

# Directories
UPLOAD_DIR=uploads
MAPS_DIR=uploads/maps

# Google Gemini API Key (Optional fallback for vision/AI map analysis)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
